{
  "name": "wifi-guardian-ui",
  "version": "2.0.5",
  "private": true,
  "author": {
    "name": "Zohaib Javed (Zeejay)"
  },
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "app": "electron .",
    "dist": "next build && electron-builder"
  },
  "build": {
    "appId": "com.wifiacguardian.app",
    "productName": "WiFi AC Guardian",
    "copyright": "Copyright © 2026 Zohaib Javed (Zeejay)",
    "files": [
      "main.js",
      "preload.js",
      "out/**/*",
      "public/**/*"
    ],
    "directories": {
      "output": "build_app"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/router.png",
      "category": "Utility"
    },
    "extraResources": [
      {
        "from": "../wifi_ac_guardian_win",
        "to": "wifi_ac_guardian_win"
      }
    ]
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.5.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
